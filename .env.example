# Copy to .env (dev: repo root, prod: /opt/kaar/.env). Never commit .env.
DB_PASSWORD=change-me-db
MQTT_INGEST_PASSWORD=change-me-ingest
MQTT_DEMO_GATEWAY_PASSWORD=change-me-gateway
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_DEMO_DB_PASSWORD=change-me-demo-role

# Production only
DOMAIN=demo.example.com
MQTT_DOMAIN=mqtt.example.com
ACME_EMAIL=you@example.com

# Optional notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
TELEGRAM_BOT_TOKEN=
